# Copy to figma-gui/.env. Set real values locally; never commit .env.
DATABASE_URL=postgresql://voltesse:CHANGE_ME@127.0.0.1:5432/voltesse_dash
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Local HTTP development only. Set true with HTTPS before accessing over a network.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TELEMETRY_MODE=SIMULATION
SESSION_MINUTES=30
BACKUP_DIR=./backups
# DATABASE mode reads the driver's existing telemetry_log; never fabricates measurements.
# To serve the built GUI from this backend: WEB_DIST=../web/dist
